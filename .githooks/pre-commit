#!/usr/bin/env bash
# Commit gate: secrets and lint.
#
# Why here and not only in CI: a committed secret stays in the history after it is removed from the file,
# and cleaning history is expensive. Blocking at commit time is the only moment where the cost is zero.
# Lint runs here too because it is fast and it prevents a commit that CI would reject two minutes later.
#
# Activation, once per clone: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact; then
    echo
    echo "commit blocked: gitleaks found a secret in the staged changes."
    echo "Remove the secret from the file, or mark the line as a false positive with the gitleaks allow comment."
    exit 1
  fi
else
  echo "warning: gitleaks is not installed, so this commit was not checked (brew install gitleaks)"
fi

pnpm lint
